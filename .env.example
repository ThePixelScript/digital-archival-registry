# ==============================================================================
# Digital Archival Registry & Museum Collection Tracker
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local development environment:
#   cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (PowerShell)
#
# DO NOT commit .env containing real secrets or production credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Elasticsearch Configuration
# ------------------------------------------------------------------------------
# Host where Elasticsearch is reachable from the backend (127.0.0.1 for host-run backend,
# or 'elasticsearch' if running FastAPI inside a shared Docker Compose network)
ELASTICSEARCH_HOST=127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http

# Elastic superuser credentials for local development
ELASTIC_USER=elastic
ELASTIC_PASSWORD=dev_archival_registry_password_replace_in_env

# Primary index name for storing and querying artifact records
ELASTICSEARCH_INDEX=museum_artifacts

# JVM Heap settings for the Elasticsearch container (set in docker-compose.yml)
# Defaults: 512m initial, 512m maximum (suitable for local dev)
ES_JAVA_OPTS=-Xms512m -Xmx512m

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Allowed origins for Cross-Origin Resource Sharing (CORS) in development
CORS_ORIGINS=["http://127.0.0.1:8000", "http://localhost:8000", "http://127.0.0.1:5500", "http://localhost:5500", "http://127.0.0.1:3000"]
